# OpenAI API key used by the shared generation pipeline (later increment).
OPENAI_API_KEY=
# Optional model override; the default is gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini
# Optional Brave Search API key for public interview discussion search.
BRAVE_SEARCH_API_KEY=
# MongoDB connection string used by the server (later increment).
MONGODB_URI=mongodb://127.0.0.1:27017/ai-interview-prep-kit
# Secret used to sign authentication tokens (later increment).
JWT_SECRET=replace-with-a-long-random-secret
# Public origin allowed to call the API (later increment).
WEB_ORIGIN=http://localhost:3000
# API origin used by the browser client.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# Set true only when running the CLI against localhost test fixtures.
ALLOW_LOCAL_FETCH=false
