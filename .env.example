# Required by the generation pipeline, including the batch CLI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Free-tier Tavily Search API key for public interview-process discussions.
TAVILY_API_KEY=

# Required by the API for persistence and authentication.
MONGODB_URI=mongodb://127.0.0.1:27017/ai-interview-prep-kit
JWT_SECRET=replace-with-a-long-random-local-secret

# Local web and API settings.
PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Only set true when the CLI must fetch a localhost test fixture.
# Keep false for normal use; the web API does not allow local fetches.
ALLOW_LOCAL_FETCH=false
